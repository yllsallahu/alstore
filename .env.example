# AL STORE V7 — environment variable template.
# Copy to .env (or .env.local) and fill in locally. NEVER commit real values.
# Anything prefixed NEXT_PUBLIC_ is sent to the browser: only the publishable key and URL may use it.
# Each environment (development / staging / production) uses its OWN Supabase project and secrets.
# Comments are always on their own line: Docker --env-file reads inline comments as part of the value.

# One of: development | staging | production
APP_ENV=development

# Development-only app shell preview without an account (rejected unless APP_ENV=development).
UI_PREVIEW=false

# --- Supabase (public-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never NEXT_PUBLIC_, never in client bundles, logs or prompts.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# --- PostgreSQL via Drizzle (added in Phase 02) ---
# Server-only; least-privilege app role.
DATABASE_URL=
# CI / migrator role only; not present on the running app.
DATABASE_MIGRATION_URL=

# --- Safety switches (both default OFF) ---
# Real invoice issuance also requires every issuance gate APPROVED in the database (docs/VAT_COMPLIANCE_GATES.md).
ISSUANCE_ENABLED=false
# Official ATK/EDI export also requires gate VG-12 APPROVED and a DIRECTOR_APPROVED period.
OFFICIAL_ATK_EXPORT_ENABLED=false

# --- Monitoring (Phase 19) ---
SENTRY_DSN=
