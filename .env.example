# AL STORE website — environment template.
# Copy to .env.local for local development. Never commit real values.
# Validated at startup by src/config/env.ts (Zod); invalid values fail the build.

# Absolute origin used for canonical URLs, hreflang, sitemap and JSON-LD. No trailing slash.
# Defaults to https://www.alstore-ks.com when unset.
SITE_URL=https://www.alstore-ks.com

# Search-engine indexing switch. "true" ONLY on the approved production deployment.
# Any other value (or unset) serves robots.txt "Disallow: /" and noindex meta tags.
SITE_INDEXABLE=false

# --- Reserved for later phases. Not read by Phase 1 code. ---
# Supabase content source (future CMS). The service-role key is server-only:
# never prefix it with NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
